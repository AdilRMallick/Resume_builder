# ---- datastores ----
JME_DATABASE_URL=postgresql+psycopg://jme:jme@localhost:5433/jme
JME_REDIS_URL=redis://localhost:6380/0

# ---- feed ----
JME_FEED_URL=https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/.github/scripts/listings.json

# ---- fetching etiquette ----
JME_USER_AGENT=job-match-engine/0.1 (+https://github.com/AdilRMallick; personal job search tool)
JME_HOST_RATE_PER_SEC=0.5
JME_HOST_BURST=1
JME_FETCH_TIMEOUT_SEC=20
JME_RESPECT_ROBOTS=true

# ---- llm ----
# Local Claude Code CLI provider. No API key: it uses the Claude subscription that
# `claude auth login` signed in on this machine, and stops when that subscription's
# usage limit is reached. Leave the path blank to auto-detect `claude` on PATH.
JME_RESUME_CLAUDE_CODE_ENABLED=true
JME_CLAUDE_CODE_CLI_PATH=
JME_RESUME_CLAUDE_CODE_MODEL=sonnet
# low is ~30s but few rewrites survive validation; medium is ~85s and most do.
JME_RESUME_CLAUDE_CODE_EFFORT=medium
JME_RESUME_CLAUDE_CODE_TIMEOUT_SEC=300

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
JME_RESUME_OPENAI_MODEL=gpt-5.6-terra
JME_RESUME_ANTHROPIC_MODEL=claude-sonnet-5
JME_RESUME_GEMINI_MODEL=gemini-3.6-flash
JME_RESUME_KIMI_MODEL=kimi-k2.6
JME_RESUME_AI_TIMEOUT_SEC=90
JME_TECTONIC_PATH=.tools/tectonic/tectonic.exe
JME_RESUME_PDF_TIMEOUT_SEC=120
JME_ANTHROPIC_MODEL=claude-opus-5
JME_ANTHROPIC_EFFORT=medium
JME_EXTRACTION_PROMPT_VERSION=v1
JME_MATCH_PROMPT_VERSION=v1
JME_MAX_COST_PER_MATCH_USD=0.05

# ---- embeddings ----
# provider: hash (deterministic, offline, dev default) | voyage
JME_EMBEDDING_PROVIDER=hash
JME_EMBEDDING_MODEL=voyage-3
JME_EMBEDDING_DIM=1536
VOYAGE_API_KEY=

# ---- eligibility ----
JME_GRAD_DATE=2027-05-01
JME_LOCATION_ALLOWLIST=Remote,Detroit,Ann Arbor,Michigan,Chicago,New York,Seattle,Austin,Boston
JME_LOCATION_BOOST=Detroit,Ann Arbor,Michigan,Chicago
JME_ROLE_TYPES=swe
JME_ALLOW_SPONSORSHIP_REQUIRED=false
JME_SHORTLIST_SIZE=20

# ---- evidence ----
JME_EVIDENCE_DIR=./evidence
JME_EVIDENCE_REPOS=AdilRMallick/llm_gateway,AdilRMallick/ev-grid-platform,AdilRMallick/etl-ml-pipeline,AdilRMallick/geo-api-platform,AdilRMallick/prismatic-raytracer,AdilRMallick/Privacy-Preserving-Measurement,AdilRMallick/secure-api-privacy
GITHUB_TOKEN=
