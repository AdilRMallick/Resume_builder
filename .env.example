# ---- datastores ----
JME_DATABASE_URL=postgresql+psycopg://jme:jme@localhost:5433/jme
JME_REDIS_URL=redis://localhost:6380/0

# ---- feed ----
JME_FEED_URL=https://raw.githubusercontent.com/SimplifyJobs/New-Grad-Positions/dev/.github/scripts/listings.json

# ---- fetching etiquette ----
JME_USER_AGENT=job-match-engine/0.1 (+https://github.com/your-handle/job-match-engine; personal job search tool)
JME_HOST_RATE_PER_SEC=0.5
JME_HOST_BURST=1
JME_FETCH_TIMEOUT_SEC=20
JME_RESPECT_ROBOTS=true

# ---- llm ----
ANTHROPIC_API_KEY=
JME_ANTHROPIC_MODEL=claude-opus-5
JME_ANTHROPIC_EFFORT=medium
JME_EXTRACTION_PROMPT_VERSION=v1
JME_MATCH_PROMPT_VERSION=v1
JME_MAX_COST_PER_MATCH_USD=0.05

# ---- embeddings ----
# provider: hash (deterministic, offline, dev default) | voyage
JME_EMBEDDING_PROVIDER=hash
JME_EMBEDDING_MODEL=voyage-3
JME_EMBEDDING_DIM=1536
VOYAGE_API_KEY=

# ---- eligibility ----
JME_GRAD_DATE=2027-05-01
JME_LOCATION_ALLOWLIST=Remote,Detroit,Ann Arbor,Michigan,Chicago,New York,Seattle,Austin,Boston
JME_LOCATION_BOOST=Detroit,Ann Arbor,Michigan,Chicago
JME_ROLE_TYPES=swe
JME_ALLOW_SPONSORSHIP_REQUIRED=false
JME_SHORTLIST_SIZE=20

# ---- evidence ----
JME_EVIDENCE_DIR=./evidence
JME_EVIDENCE_REPOS=
GITHUB_TOKEN=
